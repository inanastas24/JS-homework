		{
			"name": "Edit profile",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Отримання даних зі змінних",
							"const {",
							"    name: sentName,",
							"    lastName: sentLastName,",
							"    dateBirth: sentDateBirth,",
							"    country: sentCountry,",
							"    photo: sentPhoto",
							"} = pm.variables.toObject();",
							"",
							"// Обробка відповіді",
							"const response = pm.response.json();",
							"const responseData = response.data || {};",
							"",
							"// 1. Базова перевірка статусу",
							"pm.test(\"Статус 'ok'\", () => pm.expect(response.status).to.eql(\"ok\"));",
							"",
							"// 2. Перевірка основних полів",
							"pm.test(\"Дані профілю збігаються з відправленими\", () => {",
							"    pm.expect(responseData).to.include({",
							"        name: sentName,",
							"        lastName: sentLastName,",
							"        country: sentCountry",
							"    });",
							"});",
							"",
							"// 3. Перевірка фото (з fallback)",
							"pm.test(\"Фото відповідає очікуваному\", () => {",
							"    const expectedPhoto = sentPhoto || \"default-user.png\";",
							"    pm.expect(responseData.photoFilename).to.eql(expectedPhoto);",
							"});",
							"",
							"",
							"// 4. Перевірка обов'язкових полів",
							"pm.test(\"Наявність обов'язкових полів\", () => {",
							"    pm.expect(responseData).to.have.keys([",
							"        'name', ",
							"        'lastName', ",
							"        'dateBirth', ",
							"        'country', ",
							"        'photoFilename',",
							"        'userId'",
							"    ]);",
							"});",
							"",
							"// 5. Перевірка типів даних",
							"pm.test(\"Типи даних коректні\", () => {",
							"    pm.expect(responseData).to.have.property('name').that.is.a('string');",
							"    pm.expect(responseData).to.have.property('dateBirth').that.is.a('string');",
							"});",
							"",
							"// 6. Перевірка типів даних ",
							"pm.test(\"Типи даних коректні\", () => {",
							"    pm.expect(responseData.name).to.be.a('string');",
							"    pm.expect(responseData.lastName).to.be.a('string');",
							"    pm.expect(responseData.userId).to.be.a('number');",
							"});",
							"",
							"",
							"// 7. Обробка помилок",
							"if (pm.response.code === 400) {",
							"    pm.test(\"Повідомлення про помилку\", () => {",
							"        pm.expect(response.message).to.be.a('string').that.is.not.empty;",
							"    });",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
