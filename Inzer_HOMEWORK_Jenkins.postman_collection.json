							"const lastName = pm.variables.replaceIn('{{$randomLastName}}');",
							"const dateBirth = pm.variables.replaceIn('{{$randomDatePast}}');",
							"const country = pm.variables.replaceIn('{{$randomCountry}}');",
							"",
