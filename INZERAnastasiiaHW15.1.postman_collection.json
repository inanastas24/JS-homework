		{
			"name": "Negative tests",
			"item": [
				{
					"name": "Signup",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const testData = JSON.parse(pm.variables.get(\"MOCK_DATA\"));",
									"const currentTestIndex = pm.variables.get(\"currentTestIndex\") || 0;",
									"const currentTest = testData[currentTestIndex];",
									"",
									"// Перевірка статусу",
									"pm.test(`Status should be ${currentTest.expectedResult.status}`, () => {",
									"    pm.response.to.have.status(currentTest.expectedResult.status);",
									"});",
									"",
									"// Перевірка повідомлення про помилку",
									"pm.test(`Error message should match`, () => {",
									"    const response = pm.response.json();",
									"    pm.expect(response.message).to.eql(currentTest.expectedResult.message);",
									"});",
									"",
									"// Перехід до наступного тесту (якщо є)",
									"if (currentTestIndex < testData.length - 1) {",
									"    pm.variables.set(\"currentTestIndex\", currentTestIndex + 1);",
									"    postman.setNextRequest(pm.info.requestName); // Повторюємо цей запит",
									"} else {",
									"    pm.variables.unset(\"currentTestIndex\"); // Закінчуємо тестування",
									"    postman.setNextRequest(null);",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const  data = [{",
									"        testName: \"empty email\",",
									"        testData: { email: \"\" },",
									"        expectedResult: {",
									"            message: \"User already exists\", // Очікуємо те, що повертає API",
									"            status: 400",
									"        }",
									"    },",
									"    {",
									"    testName: \"empty email\",",
									"    testData: {",
									"        email: \"\",",
									"    },",
									"    expectedResult: {",
									"        message: \"Empty email is not alowed\",",
									"        status: 400",
									"    }",
									"},",
									"{",
									"    testName: \"empty password\",",
									"    testData: {",
									"        password: \"\",",
									"    },",
									"    expectedResult: {",
									"        message: \"Empty password is not alowed\",",
									"        status: 400",
									"    }",
									"},",
									"{",
									"    testName: \"empty name\",",
									"    testData: {",
									"        name: \"\",",
									"    },",
									"    expectedResult: {",
									"        message: \"Empty name is not alowed\",",
									"        status: 400",
									"    }",
									"},",
									"{",
									"    testName: \"empty lastName\",",
									"    testData: {",
									"        lastName: \"\",",
									"    },",
									"    expectedResult: {",
									"        message: \"Empty lastName is not alowed\",",
									"        status: 400",
									"    }",
									"},",
									"{",
									"    testName: \"Wrong length name\",",
									"    testData: {",
									"        name: \"a\",",
									"    },",
									"    expectedResult: {",
									"        message: \"Name has to be from 2 to 20 characters long\",",
									"        status: 400",
									"    }",
									"},",
									"{",
									"    testName: \"Wrong length name\",",
									"    testData: {",
									"        name: \"Rachelewweweweewrewrwerwerwerwerwerwrwerwerwer\",",
									"    },",
									"    expectedResult: {",
									"        message: \"Name has to be from 2 to 20 characters long\",",
									"        status: 400",
									"    }",
									"}",
									"]",
									"",
									"pm.variables.set(\"MOCK_DATA\", JSON.stringify(data));"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
