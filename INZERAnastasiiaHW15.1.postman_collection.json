			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Генерація нового паролю",
							"function generatePassword() {",
							"    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';",
							"    let password = '';",
							"    ",
							"    password += chars.charAt(Math.floor(Math.random() * 26));",
							"    password += chars.charAt(52 + Math.floor(Math.random() * 10));",
							"    ",
							"    for (let i = 0; i < 6 + Math.floor(Math.random() * 5); i++) {",
							"        password += chars.charAt(Math.floor(Math.random() * chars.length));",
							"    }",
							"    ",
							"    return password;",
							"}",
							"",
							"const newPassword = generatePassword();",
							"pm.collectionVariables.set(\"temp_new_password\", newPassword);",
							"pm.collectionVariables.set(\"new_password_for_test\", newPassword); // Додаткова змінна для тестів",
							"",
							"console.log(\"Поточний пароль:\", pm.collectionVariables.get(\"password\"));",
							"console.log(\"Новий пароль:\", newPassword);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Отримуємо новий пароль зі змінних",
							"const newPassword = pm.collectionVariables.get(\"new_password_for_test\");",
							"",
							"// Основні тести",
							"pm.test(\"Статус код успішний\", function() {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"pm.test(\"Відповідь містить userId\", function() {",
							"    pm.expect(pm.response.json().data).to.have.property('userId');",
							"});",
							"",
							"// Перевірка userId",
							"const responseData = pm.response.json().data;",
							"const savedUserId = pm.environment.get(\"savedUserId\");",
							"",
							"if (pm.response.code === 200 || pm.response.code === 201) {",
							"    pm.test(\"userId залишився незмінним\", function() {",
							"        pm.expect(responseData.userId).to.eql(savedUserId);",
							"    });",
							"",
							"    // Оновлення пароля",
							"    pm.collectionVariables.set(\"password\", newPassword);",
							"    pm.collectionVariables.unset(\"temp_new_password\");",
							"    pm.collectionVariables.unset(\"new_password_for_test\");",
							"    console.log(\"Пароль оновлено. Новий пароль:\", newPassword);",
							"}",
							"",
							"// Обробка помилок",
